---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  article?: boolean;
  date?: Date;
  noindex?: boolean;
}
const {
  title,
  description = 'Notes from the workbench. Elixir, Zig, Rust, C, and everything between software and silicon.',
  active = 'Writing',
  article = false,
  date,
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} — code0100fun`
  : 'code0100fun — Serious code. Playful curiosity.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111213" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="code0100fun RSS"
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="code0100fun" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@code0100fun" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="wordmark" aria-label="code0100fun home">
          <span class="logo-mark" aria-hidden="true">
            [<span>:</span>]
          </span>
          <span>code<span class="logo-digits">0100</span>fun</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          {['Writing', 'Projects', 'About'].map((item) => (
            <a
              href={item === 'Writing' ? '/' : `/${item.toLowerCase()}/`}
              class:list={{ active: active === item }}
              aria-current={active === item ? 'page' : undefined}
            >
              {item}
            </a>
          ))}
        </nav>
        <div class="header-links">
          <a href="https://github.com/code0100fun" aria-label="GitHub">
            <Icon name="github" size={19} />
          </a>
          <a href="https://x.com/code0100fun" aria-label="X">
            <Icon name="x" size={17} />
          </a>
          <span class="nav-divider"></span>
          <a href="/rss.xml" class="rss-nav">
            <Icon name="rss" size={17} />
            <span>RSS</span>
          </a>
        </div>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <a class="footer-logo" href="/">
          code0100fun.com
        </a>
        <span class="footer-note">Made of bits. Built out of curiosity.</span>
      </div>
      <div class="footer-right">
        <span>© {new Date().getFullYear()} Chase McCarthy</span>
        <span class="dark-label">
          <Icon name="moon" size={14} /> Dark by design
        </span>
        <a href="/rss.xml" aria-label="Subscribe via RSS">
          <Icon name="rss" size={17} />
        </a>
      </div>
    </footer>
  </body>
</html>
