---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { publicProjects, upcomingProjects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout
  title="Projects"
  active="Projects"
  description="Open-source projects by code0100fun. Web apps, hardware, developer tools, and game experiments."
>
  <header class="page-intro">
    <div class="eyebrow">
      <span class="orange-dash"></span> BUILT OUT OF CURIOSITY
    </div>
    <h1>
      On the workbench<span class="heading-dot">.</span>
    </h1>
    <p>
      A few of the things I’ve been building and exploring. Software, silicon,
      and the interesting places where they meet.
    </p>
  </header>
  <div class="project-grid project-page-grid">
    {publicProjects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
  {upcomingProjects.length > 0 && (
    <section class="upcoming-projects" aria-labelledby="upcoming-heading">
      <div class="section-heading">
        <h2 id="upcoming-heading">
          Coming soon<span class="heading-dot">.</span>
        </h2>
      </div>
      <p class="upcoming-intro">
        Still behind the scenes. These repositories are private for now, with
        public releases on the way.
      </p>
      <div class="project-grid project-page-grid">
        {upcomingProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  )}
  <div class="page-links">
    <a class="button" href="https://github.com/code0100fun">
      code0100fun on GitHub <Icon name="github" size={17} />
    </a>
    <a class="button" href="https://github.com/ctxshift">
      ctxshift on GitHub <Icon name="github" size={17} />
    </a>
    <a class="button" href="/#writing">
      Read the field notes <Icon name="arrow" size={17} />
    </a>
  </div>
</Layout>
