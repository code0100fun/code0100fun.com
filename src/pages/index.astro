---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Life from '../components/Life.astro';
import PostArt from '../components/PostArt.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts, readingTime, formatDate } from '../lib/posts';
import { publicProjects as projects } from '../data/projects';
const posts = await publishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const others = posts.filter((post) => post.id !== featured?.id);
const topics = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="orange-dash"></span> NOTES FROM THE WORKBENCH
      </div>
      <h1>
        Serious code.
        <br />
        <span>Playful curiosity.</span>
      </h1>
      <p>
        I’m Chase. I build things, take them apart, and write about
        <br class="desktop-break" /> what I find. From web apps to the bare
        metal.
      </p>
      <div class="hero-languages">
        <span>
          <i class="dot elixir"></i>Elixir
        </span>
        <span>
          <i class="dot zig"></i>Zig
        </span>
        <span>
          <i class="dot rust"></i>Rust
        </span>
        <span>
          <i class="dot c"></i>C
        </span>
        <span class="and-more">& whatever works.</span>
      </div>
    </div>
    <div class="hero-playground">
      <Life compact />
      <div class="playground-caption">
        <span>↑</span> A tiny universe. Click a cell, then hit run.
      </div>
    </div>
  </section>

  <div class="workbench-strip">
    <span>
      <Icon name="terminal" size={16} /> Software. Silicon. Side quests.
    </span>
    <span>
      Always something on the workbench <span class="blinking-cursor">_</span>
    </span>
  </div>

  {featured && (
    <section class="featured-section" aria-label="Featured post">
      <a
        class="featured-art"
        href={`/writing/${featured.id}/`}
        tabindex="-1"
        aria-hidden="true"
      >
        <PostArt type={featured.data.art} large />
      </a>
      <div class="featured-copy">
        <div class="featured-kicker">
          <Icon name="spark" size={14} /> FEATURED FIELD NOTE{' '}
          {featured.data.example && <span>EXAMPLE POST</span>}
        </div>
        <h2>
          <a href={`/writing/${featured.id}/`}>{featured.data.title}</a>
        </h2>
        <p>{featured.data.description}</p>
        <div class="tags">
          {featured.data.tags.map((tag) => (
            <a
              class={`tag tag-${tag.toLowerCase()}`}
              href={`/?tag=${encodeURIComponent(tag)}#writing`}
            >
              {tag}
            </a>
          ))}
        </div>
        <div class="featured-bottom">
          <span>
            {formatDate(featured.data.date)}
            <span class="meta-dot">·</span>
            {readingTime(featured)} min read
          </span>
          <a href={`/writing/${featured.id}/`}>
            Read the story <Icon name="arrow" size={17} />
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="writing-section" id="writing">
    <div class="section-heading">
      <h2>
        Latest writing<span class="heading-dot">.</span>
      </h2>
      <span class="section-aside">
        Experiments, rabbit holes, and things learned.
      </span>
    </div>
    <div class="writing-toolbar">
      <div class="topic-filters" aria-label="Filter posts by topic">
        <button
          type="button"
          data-filter="all"
          class="selected"
          aria-pressed="true"
        >
          All posts <span>{posts.length}</span>
        </button>
        {topics.map((topic) => (
          <button
            type="button"
            data-filter={topic.toLowerCase()}
            aria-pressed="false"
          >
            {topic}
          </button>
        ))}
      </div>
      <label class="post-search">
        <Icon name="search" size={16} />
        <input
          type="search"
          placeholder="Find a rabbit hole…"
          aria-label="Search posts"
        />
        <kbd>/</kbd>
      </label>
    </div>
    <div class="posts-grid">
      {others.map((post) => (
        <PostCard post={post} />
      ))}
      {featured && (
        <div class="featured-search-result" hidden>
          <PostCard post={featured} />
        </div>
      )}
    </div>
    <p class="empty-results" hidden>
      No field notes here yet. Try another topic or search.
    </p>
    <p class="filter-status sr-only" role="status" aria-live="polite"></p>
    <div class="end-of-posts">
      <span></span>
      <p>You’re all caught up. More experiments soon.</p>
      <span></span>
    </div>
  </section>

  <section class="projects-preview">
    <div class="section-heading">
      <h2>
        On the workbench<span class="heading-dot">.</span>
      </h2>
      <a class="text-link" href="/projects/">
        Explore projects <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="project-grid">
      {projects.slice(0, 3).map((project) => (
        <a class="project-card" href={project.url}>
          <div class="project-icon">
            <Icon name={project.icon} size={22} />
          </div>
          <div>
            <h3>
              {project.name} <Icon name="external" size={14} />
            </h3>
            <p>{project.description}</p>
            <span class="project-language">
              <i class={`dot ${project.language.toLowerCase()}`} />
              {project.language}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="follow-strip">
    <div>
      <span class="follow-icon">
        <Icon name="rss" size={23} />
      </span>
      <div>
        <h2>Follow the curiosity.</h2>
        <p>New posts, straight to your feed reader. No noise.</p>
      </div>
    </div>
    <a class="button" href="/rss.xml">
      Subscribe via RSS <Icon name="arrow" size={17} />
    </a>
  </section>
</Layout>
<script>
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
  );
  const search =
    document.querySelector<HTMLInputElement>('.post-search input')!;
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('.posts-grid .post-card'),
  );
  const featuredResult = document.querySelector<HTMLElement>(
    '.featured-search-result',
  );
  let active =
    new URLSearchParams(location.search).get('tag')?.toLowerCase() ?? 'all';
  if (!filters.some((button) => button.dataset.filter === active))
    active = 'all';
  function filterPosts() {
    const query = search.value.trim().toLowerCase();
    const filtering = active !== 'all' || Boolean(query);
    let count = 0;
    if (featuredResult) featuredResult.hidden = !filtering;
    filters.forEach((button) => {
      const selected = button.dataset.filter === active;
      button.classList.toggle('selected', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    cards.forEach((card) => {
      const matches =
        (active === 'all' || card.dataset.tags?.split(',').includes(active)) &&
        card.dataset.search!.includes(query);
      card.hidden = !matches;
      if (matches && (!card.closest('.featured-search-result') || filtering))
        count++;
    });
    document.querySelector<HTMLElement>('.empty-results')!.hidden = count > 0;
    document.querySelector<HTMLElement>('.end-of-posts')!.hidden = filtering;
    document.querySelector('.filter-status')!.textContent =
      `${count} ${count === 1 ? 'post' : 'posts'} shown`;
  }
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      active = button.dataset.filter!;
      const url = new URL(location.href);
      active === 'all'
        ? url.searchParams.delete('tag')
        : url.searchParams.set('tag', active);
      history.replaceState(null, '', url);
      filterPosts();
    }),
  );
  search.addEventListener('input', filterPosts);
  document.addEventListener('keydown', (event) => {
    if (
      event.key === '/' &&
      !(event.target instanceof HTMLInputElement) &&
      !(event.target instanceof HTMLTextAreaElement) &&
      !(event.target instanceof HTMLElement && event.target.isContentEditable)
    ) {
      event.preventDefault();
      search.focus();
    }
    if (event.key === 'Escape' && document.activeElement === search) {
      search.value = '';
      filterPosts();
      search.blur();
    }
  });
  filterPosts();
</script>
